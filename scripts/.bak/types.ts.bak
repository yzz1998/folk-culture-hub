/**
 * 各学科的定位说明——这是「各学科与民俗演示之间是什么关系」的唯一数据源。
 * 学科总览页、教案库标记、智能工坊提示都从这里取用，避免各处口径不一。
 */
export interface SubjectMeta {
  key: Subject
  /** 该学科在小学阶段的主线内容，用于说明「它自己讲什么」 */
  ownCore: string
  affinity: FolkAffinity
  /** 民俗能为该学科提供什么；affinity 为 none 时说明为什么不必关联 */
  folkRole: string
  /** 本站对该学科的呈现方式 */
  presentation: string
  /** 典型内容线索 */
  topics: string[]
}

