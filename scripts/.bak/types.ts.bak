/** 取学科主线的第一句并去掉尾随标点，便于直接拼进句子 */
export function subjectCoreBrief(subject: Subject): string {
  return SUBJECT_META[subject].ownCore.split('；')[0].replace(/[。，、；\s]+$/, '')
}

