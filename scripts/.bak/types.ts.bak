/** 课时表述：40 分钟为 1 课时，其余保持分钟数 */
export function durationLabel(minutes: number): string {
  const k = minutes / 40
  return Number.isInteger(k) && k >= 1 ? `${k} 课时` : `${minutes} 分钟`
}
