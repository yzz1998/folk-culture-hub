/* ═══════════════════════════════════════════════════════════════
   核心类型契约
   所有页面、数据文件与智能体共用这一套结构。
   新增课程知识模块时只需扩展 curriculum.ts，无需改动页面。
   ═══════════════════════════════════════════════════════════════ */

export type FolkCategory =
  | '节日节庆'
  | '二十四节气'
  | '民间技艺'
  | '服饰民居'
  | '饮食民俗'
  | '民间游艺'
  | '信仰祭祀'
  | '民间文学'

export type GradeBand = '1-2' | '3-4' | '5-6'

/**
 * 小学阶段国家课程学科（《义务教育课程方案（2022 年版）》共 10 门）
 * 外加本平台所服务的《人类与社会》课程本身。
 */
export type Subject =
  | '语文'
  | '数学'
  | '英语'
  | '道德与法治'
  | '科学'
  | '体育与健康'
  | '艺术'
  | '劳动'
  | '信息科技'
  | '综合实践'
  | '人类社会'

/** 民俗与某一学科的关联强度。民俗只是当前的重点演示方向，不是所有学科的共同入口。 */
export type FolkAffinity = 'strong' | 'fair' | 'weak' | 'none'

export type Region = '全国' | '闽东'

export type Theme =
  | '家国情怀'
  | '家族伦理'
  | '人与自然'
  | '技艺传承'
  | '多元一体'
  | '生活智慧'

/* ── 纹样生成参数（剪纸风格 SVG） ───────────────────── */
export type Motif =
  | 'flower' // 团花
  | 'window' // 窗格
  | 'fish' // 鱼
  | 'bird' // 鸟
  | 'dragon' // 龙
  | 'cloud' // 云纹
  | 'wave' // 水波
  | 'mountain' // 山形
  | 'lantern' // 灯笼
  | 'fret' // 回纹

export type PaletteName = 'cinnabar' | 'indigo' | 'ochre' | 'bamboo' | 'ink'

export interface PatternSpec {
  motif: Motif
  palette: PaletteName
  density: 1 | 2 | 3
}

/* ── 民俗文化条目 ──────────────────────────────────── */
export interface FolkItem {
  id: string
  name: string
  category: FolkCategory
  region: Region
  themes: Theme[]
  subjects: Subject[]
  grades: GradeBand[]
  /** 一句话概述 */
  summary: string
  /** 文化内涵，智能体核心取用字段 */
  culturalMeaning: string
  /** 源流脉络 */
  origin: string
  /** 课堂可切入的三个观察点 */
  classroomHooks: string[]
  keywords: string[]
  /** 关联的课程知识点 id */
  curriculumLinks: string[]
  materialIds: string[]
  pattern: PatternSpec
  /** 时令推荐月份 */
  seasonMonths?: number[]
  /** 常见教学误区提示，教师视角的实用信息 */
  caution?: string
}

/* ── 课程知识结构（可扩展） ────────────────────────── */
export interface KnowledgePoint {
  id: string
  title: string
  summary: string
  gradeBand?: GradeBand
  /** 反向推荐：适合结合的民俗 id */
  folkHooks: string[]
  /** ready = 已有内容；planned = 预留位，等待补充 */
  status: 'ready' | 'planned'
}

export interface CurriculumUnit {
  id: string
  title: string
  points: KnowledgePoint[]
}

export interface CurriculumChapter {
  id: string
  order: number
  title: string
  brief: string
  /** 该章与民俗文化的天然结合点，一句话 */
  folkAngle: string
  units: CurriculumUnit[]
}

/* ── 教案 ──────────────────────────────────────────── */
export interface FlowStage {
  stage: string
  minutes: number
  teacher: string
  student: string
  intent: string
}

/** 活动形式。民俗融合课多用前六类，学科本体课会用到后面的操作/实验/练习等。 */
export type ActivityType =
  | '体验'
  | '探究'
  | '表达'
  | '制作'
  | '讨论'
  | '游戏'
  | '操作'
  | '实验'
  | '观察'
  | '设计'
  | '练习'
  | '比赛'
  | '创作'
  | '辨析'
  | '写作'
  | '考察'

export interface Activity {
  name: string
  type: ActivityType
  minutes: number
  desc: string
  grouping: string
}

export interface Objectives {
  knowledge: string
  ability: string
  emotion: string
}

/**
 * 课例与民俗的关系。民俗只是当前的重点演示方向，不是所有课例的共同前提。
 * core    —— 民俗是内容本体（如剪纸、节日）
 * support —— 民俗作情境或素材引入，学科内容仍是主体
 * none    —— 不涉及民俗，学科内容独立呈现
 */
export type FolkLink = 'core' | 'support' | 'none'

export const FOLK_LINK_LABEL: Record<FolkLink, string> = {
  core: '民俗本体',
  support: '民俗作素材',
  none: '学科本体',
}

export interface LessonPlan {
  id: string
  title: string
  folkIds: string[]
  chapterId: string
  pointIds: string[]
  gradeBand: GradeBand
  subject: Subject
  duration: number
  /** 本课与民俗的关系；缺省时按 folkIds 是否为空推断 */
  folkLink?: FolkLink
  objectives: Objectives
  keyPoints: string[]
  difficultPoints: string[]
  preparation: string[]
  flow: FlowStage[]
  activities: Activity[]
  evaluation: string
  homework: { basic: string; extend: string; project: string }
  differentiation: { support: string; challenge: string }
  boardDesign?: string
  reflection?: string
  /** 教学尺度提醒：涉及信仰、民族、家庭结构等敏感内容时的处理建议 */
  caution?: string
}

/* ── 素材 ──────────────────────────────────────────── */
export type MaterialType = 'image' | 'audio' | 'video' | 'text'

export interface Material {
  id: string
  type: MaterialType
  title: string
  folkId: string
  desc: string
  /** 音视频条目：建议时长 */
  duration?: string
  /** 文本素材正文 */
  body?: string
  /** 用途标注 */
  usage?: string
  /** 素材状态：placeholder = 待替换为本校素材 */
  status: 'ready' | 'placeholder'
  /** 图片素材的纹样参数，无则为 undefined */
  pattern?: PatternSpec
}

/* ── 智能体 ────────────────────────────────────────── */
export type TeachStyle =
  | '体验探究'
  | '知识讲授'
  | '项目式'
  | '情境任务'
  | '复习巩固'
  | '跨学科主题'
export type EngineKind = 'local' | 'llm'

export interface AgentInput {
  folkIds: string[]
  pointIds: string[]
  gradeBand: GradeBand
  subject: Subject
  /** 教师自拟的课程主题，直接作为教案标题 */
  topic?: string
  duration: number
  style: TeachStyle
  /** 已选学情预设的 id（见 src/data/teachingPresets.ts），可空 */
  issues?: string[]
  /** 教师补充的学情说明，可空 */
  notes?: string
}

export interface RationaleItem {
  label: string
  text: string
}

export interface GeneratedPlan {
  id: string
  createdAt: number
  title: string
  input: AgentInput
  rationale: RationaleItem[]
  plan: LessonPlan
  engine: EngineKind
  /** 生成时的引擎备注，例如「大模型不可用，已切换本地引擎」 */
  note?: string
}

/* ── 收藏 / 草稿 / 交流 ────────────────────────────── */
export type CollectionKind = 'folk' | 'lesson' | 'plan'

export interface Draft {
  id: string
  title: string
  savedAt: number
  plan: LessonPlan
}

export interface Post {
  id: string
  createdAt: number
  author: string
  title: string
  body: string
  folkIds: string[]
  gradeBand?: GradeBand
  likes: number
  sample?: boolean
}

/* ── 设置 ──────────────────────────────────────────── */
export interface LlmSettings {
  enabled: boolean
  baseUrl: string
  apiKey: string
  model: string
}

export const DEFAULT_LLM_SETTINGS: LlmSettings = {
  enabled: false,
  baseUrl: 'https://api.deepseek.com/v1',
  apiKey: '',
  model: 'deepseek-chat',
}

/* ── 字典与展示辅助 ────────────────────────────────── */
