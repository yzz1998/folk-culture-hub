/* 每条民俗自动配一张纹样插画素材 */
export const FOLK: FolkItem[] = SEEDS.map((f) => ({
  ...f,
  materialIds: [`img-${f.id}`],
}))

export const FOLK_MAP = new Map(FOLK.map((f) => [f.id, f]))

export function getFolk(id: string | undefined): FolkItem | undefined {
  return id ? FOLK_MAP.get(id) : undefined
}

export const LOCAL_FOLK = FOLK.filter((f) => f.region === '闽东')

/** 按当前月份筛出应季民俗，用于首页时令推荐 */
export function seasonalFolk(month: number, limit = 6): FolkItem[] {
  const hit = FOLK.filter((f) => f.seasonMonths?.includes(month))
  // 不足时用临近月份补齐
  const near =
    hit.length >= limit
      ? []
      : FOLK.filter(
          (f) =>
            !hit.includes(f) &&
            f.seasonMonths?.some(
              (m) => Math.min(Math.abs(m - month), 12 - Math.abs(m - month)) <= 2,
            ),
        )
  const pool = [...hit, ...near]

  // 同屏尽量不撞母题，否则一排卡片看起来像复读
  const out: FolkItem[] = []
  const seen = new Set<string>()
  for (const f of pool) {
    if (out.length >= limit) break
    if (seen.has(f.pattern.motif)) continue
    seen.add(f.pattern.motif)
    out.push(f)
  }
  // 母题不够凑满时按原顺序补齐
  for (const f of pool) {
    if (out.length >= limit) break
    if (!out.includes(f)) out.push(f)
  }
  return out
}
